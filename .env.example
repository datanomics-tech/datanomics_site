# Copy this file to .env and fill in your values. Never commit .env to Git.

# --- Server ---
PORT=3000
NODE_ENV=production
# Public address of the site (used in canonical links and the sitemap)
SITE_URL=https://www.datanomics.rw
# Long random string; generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when the site is served over HTTPS behind Nginx/cPanel (secure cookies)
TRUST_PROXY=1

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=datanomics
DB_PASSWORD=change-me
DB_NAME=datanomics

# --- First admin account (used by `npm run db:setup` and `npm run admin:create`) ---
ADMIN_NAME=Frank Shimirwa Muyoboke
ADMIN_EMAIL=admin@datanomics.rw
ADMIN_PASSWORD=ChangeThisPassword!2026

# --- Google Sheet in your shared Drive (see google-apps-script/README) ---
# Web app URL from Apps Script "Deploy > New deployment"
SHEETS_WEBHOOK_URL=
# The same secret you set in the Apps Script (SECRET constant)
SHEETS_SECRET=
# Link to open the spreadsheet (shown as a button in the admin panel)
SHEETS_VIEW_URL=

# --- Insights auto-fetch ---
# Cron schedule (server time). Default: every day at 06:00
FEEDS_CRON=0 6 * * *
